<Window x:Class="DahuaUserManager.UI.Windows.WorkScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графики работы"
        Height="480"
        Width="760"
        MinHeight="400"
        MinWidth="650"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top"
                   Text="Графики работы"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Добавить"
                    Width="110"
                    Height="34"
                    Margin="4"
                    Click="Add_Click"/>

            <Button Content="Удалить"
                    Width="110"
                    Height="34"
                    Margin="4"
                    Click="Delete_Click"/>

            <Button Content="Сохранить"
                    Width="110"
                    Height="34"
                    Margin="4"
                    Click="Save_Click"/>

            <Button Content="Закрыть"
                    Width="110"
                    Height="34"
                    Margin="4"
                    Click="Close_Click"/>

        </StackPanel>

        <DataGrid x:Name="SchedulesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Начало"
                                    Binding="{Binding StartTime}"
                                    Width="120"/>

                <DataGridTextColumn Header="Конец"
                                    Binding="{Binding EndTime}"
                                    Width="120"/>

                <DataGridTextColumn Header="Норма часов"
                                    Binding="{Binding NormHours}"
                                    Width="120"/>

                <DataGridCheckBoxColumn Header="Активен"
                                        Binding="{Binding IsActive}"
                                        Width="90"/>

            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>
</Window>