<Window x:Class="DahuaUserManager.UI.Windows.EmployeeScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначение графиков сотрудникам"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top"
                   Text="Назначение графиков сотрудникам"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Назначить"
                    Width="120"
                    Height="34"
                    Margin="4"
                    Click="Assign_Click"/>

            <Button Content="Обновить"
                    Width="120"
                    Height="34"
                    Margin="4"
                    Click="Refresh_Click"/>

            <Button Content="Закрыть"
                    Width="120"
                    Height="34"
                    Margin="4"
                    Click="Close_Click"/>
        </StackPanel>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Сотрудник:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="EmployeeComboBox"
                              Grid.Column="1"
                              Height="30"
                              DisplayMemberPath="DisplayName"/>

                    <TextBlock Grid.Column="2"
                               Text="График:"
                               VerticalAlignment="Center"
                               Margin="18,0,8,0"/>

                    <ComboBox x:Name="ScheduleComboBox"
                              Grid.Column="3"
                              Height="30"
                              DisplayMemberPath="DisplayName"/>

                    <TextBlock Grid.Column="4"
                               Text="Действует с:"
                               VerticalAlignment="Center"
                               Margin="18,0,8,0"/>

                    <DatePicker x:Name="DateFromPicker"
                                Grid.Column="5"
                                Height="30"/>

                </Grid>

            </Border>

            <DataGrid x:Name="AssignmentsGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="UserID"
                                        Binding="{Binding UserId}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Сотрудник"
                                        Binding="{Binding UserName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="График"
                                        Binding="{Binding ScheduleName}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Начало"
                                        Binding="{Binding StartTime}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Конец"
                                        Binding="{Binding EndTime}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Норма"
                                        Binding="{Binding NormHours}"
                                        Width="90"/>

                    <DataGridTextColumn Header="С даты"
                                        Binding="{Binding DateFrom}"
                                        Width="110"/>

                    <DataGridTextColumn Header="По дату"
                                        Binding="{Binding DateTo}"
                                        Width="110"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </DockPanel>
</Window>