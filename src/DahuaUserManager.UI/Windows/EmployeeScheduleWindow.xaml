<Window x:Class="DahuaUserManager.UI.Windows.EmployeeScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначение графиков сотрудникам"
        Height="720"
        Width="1050"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top"
                   Text="Назначение графиков сотрудникам"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Назначить отмеченным"
                    Width="170"
                    Height="34"
                    Margin="4"
                    Click="Assign_Click"/>

            <Button Content="Удалить назначение"
                    Width="160"
                    Height="34"
                    Margin="4"
                    Click="DeleteAssignment_Click"/>

            <Button Content="Обновить"
                    Width="120"
                    Height="34"
                    Margin="4"
                    Click="Refresh_Click"/>

            <Button Content="Закрыть"
                    Width="120"
                    Height="34"
                    Margin="4"
                    Click="Close_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="210"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Сотрудники -->
                    <GroupBox Grid.Column="0"
                              Header="Сотрудники">

                        <DockPanel Margin="6">

                            <StackPanel DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0">

                                <TextBlock x:Name="SelectedEmployeesText"
                                           Text="Отмечено: 0"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <Button Content="Все"
                                        Width="70"
                                        Height="28"
                                        Margin="3"
                                        Click="SelectAllEmployees_Click"/>

                                <Button Content="Очистить"
                                        Width="80"
                                        Height="28"
                                        Margin="3"
                                        Click="ClearEmployees_Click"/>
                            </StackPanel>

                            <ListBox x:Name="EmployeesListBox"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="2"
                                                  Checked="EmployeeCheckBox_Changed"
                                                  Unchecked="EmployeeCheckBox_Changed"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                        </DockPanel>

                    </GroupBox>

                    <!-- Параметры назначения -->
                    <GroupBox Grid.Column="2"
                              Header="Назначение">

                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="График:"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="ScheduleComboBox"
                                      Grid.Column="1"
                                      Height="30"
                                      DisplayMemberPath="DisplayName"
                                      VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                                       Text="Действует с:"
                                       VerticalAlignment="Center"/>

                            <DatePicker x:Name="DateFromPicker"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Height="30"
                                        VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="Выбранный график и дата будут назначены всем сотрудникам, отмеченным галочками слева."
                                       TextWrapping="Wrap"
                                       Foreground="Gray"
                                       VerticalAlignment="Top"
                                       Margin="0,10,0,0"/>

                        </Grid>

                    </GroupBox>

                </Grid>

            </Border>

            <!-- Текущие назначения -->
            <DataGrid x:Name="AssignmentsGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="UserID"
                                        Binding="{Binding UserId}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Сотрудник"
                                        Binding="{Binding UserName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="График"
                                        Binding="{Binding ScheduleName}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Начало"
                                        Binding="{Binding StartTime}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Конец"
                                        Binding="{Binding EndTime}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Норма"
                                        Binding="{Binding NormHours}"
                                        Width="90"/>

                    <DataGridTextColumn Header="С даты"
                                        Binding="{Binding DateFrom}"
                                        Width="110"/>

                    <DataGridTextColumn Header="По дату"
                                        Binding="{Binding DateTo}"
                                        Width="110"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </DockPanel>
</Window>
