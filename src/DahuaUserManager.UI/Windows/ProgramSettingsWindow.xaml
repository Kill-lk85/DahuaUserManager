<Window x:Class="DahuaUserManager.UI.Windows.ProgramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки программы"
        Width="760"
        Height="560"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Настройки программы"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <GroupBox Grid.Row="1"
                  Header="Резервное копирование"
                  Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Папка с базами:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="DatabaseFolderBox"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,6,0,6"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="1"
                           Text="Куда сохранять архивы:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="BackupFolderBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,6,8,6"/>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="Обзор..."
                        Margin="0,6,0,6"
                        Click="BrowseBackupFolder_Click"/>

                <TextBlock Grid.Row="2"
                           Text="7-Zip:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SevenZipPathBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,6,8,6"/>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Content="Обзор..."
                        Margin="0,6,0,6"
                        Click="BrowseSevenZip_Click"/>

                <TextBlock Grid.Row="3"
                           Text="Пароль архива:"
                           VerticalAlignment="Center"/>

                <PasswordBox x:Name="BackupPasswordBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Margin="0,6,0,6"/>

                <TextBlock Grid.Row="4"
                           Text="Шифрование:"
                           VerticalAlignment="Center"/>

                <CheckBox x:Name="EncryptFileNamesBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Content="Шифровать имена файлов внутри архива"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Row="5"
                           Text="Автоматический бэкап:"
                           VerticalAlignment="Center"/>

                <CheckBox x:Name="AutomaticBackupBox"
                          Grid.Row="5"
                          Grid.Column="1"
                          Content="Включён"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="2"
                           Text="через Планировщик Windows"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="Gray"/>

                <TextBlock Grid.Row="6"
                           Text="Время:"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="6"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal">

                    <TextBox x:Name="BackupTimeBox"
                             Width="90"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Margin="0,7,20,7"/>

                    <TextBlock Text="Хранить:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="RetentionDaysBox"
                             Width="70"
                             Height="30"
                             Margin="8,7,8,7"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="дней"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="7"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,18,0,0">

                    <Button Content="Сделать бэкап сейчас"
                            Width="180"
                            Height="36"
                            Click="BackupNow_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Сохранить"
                    Width="110"
                    Height="36"
                    Margin="4"
                    IsDefault="True"
                    Click="Save_Click"/>

            <Button Content="Отмена"
                    Width="110"
                    Height="36"
                    Margin="4"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
