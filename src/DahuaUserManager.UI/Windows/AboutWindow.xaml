<Window x:Class="DahuaUserManager.UI.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="680"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Dahua User Manager"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Версия 1.2"
                       Foreground="Gray"
                       Margin="0,6,0,14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,10,0,10">

            <TextBlock TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22">

                <Run Text="Назначение&#x0a;&#x0a;"/>

                <Run Text="Dahua User Manager предназначен для централизованного управления пользователями, картами доступа, фотографиями, контроллерами доступа Dahua и учётом рабочего времени сотрудников.&#x0a;&#x0a;"/>

                <Run Text="Программа разработана как лёгкая и быстрая альтернатива SmartPSS для повседневной работы с несколькими контроллерами и объектами.&#x0a;&#x0a;"/>


                <Run Text="Основные возможности&#x0a;&#x0a;"/>

                <Run Text="• Управление несколькими контроллерами Dahua.&#x0a;"/>

                <Run Text="• Поддержка нескольких объектов с отдельными базами данных.&#x0a;"/>

                <Run Text="• Выбор рабочей базы при запуске программы.&#x0a;"/>

                <Run Text="• Отдельный список контроллеров для каждой базы объекта.&#x0a;"/>

                <Run Text="• Хранение настроек контроллеров непосредственно в SQLite-базе выбранного объекта.&#x0a;"/>

                <Run Text="• Автоматическое определение поддерживаемого API контроллера.&#x0a;"/>

                <Run Text="• Создание пользователей.&#x0a;"/>

                <Run Text="• Редактирование пользователей с фактической записью изменений на контроллеры.&#x0a;"/>

                <Run Text="• Одновременное создание и редактирование пользователей на нескольких выбранных контроллерах.&#x0a;"/>

                <Run Text="• Назначение и изменение карт доступа.&#x0a;"/>

                <Run Text="• Загрузка фотографий лиц.&#x0a;"/>

                <Run Text="• Захват фотографии непосредственно с камеры контроллера.&#x0a;"/>

                <Run Text="• Удаление пользователей с выбранного контроллера.&#x0a;"/>

                <Run Text="• Удаление пользователей сразу со всех контроллеров объекта.&#x0a;"/>

                <Run Text="• Контроль доступности контроллеров.&#x0a;"/>

                <Run Text="• Назначение контроллерам ролей входа и выхода для учёта посещаемости.&#x0a;"/>

                <Run Text="• Автоматическое сохранение расположения и ширины колонок.&#x0a;&#x0a;"/>


                <Run Text="Посещаемость и учёт рабочего времени&#x0a;&#x0a;"/>

                <Run Text="• Получение событий проходов непосредственно с контроллеров Dahua.&#x0a;"/>

                <Run Text="• Сохранение истории посещаемости в локальной SQLite-базе объекта.&#x0a;"/>

                <Run Text="• Повторная синхронизация без дублирования ранее полученных событий.&#x0a;"/>

                <Run Text="• Формирование отчётов за выбранный период.&#x0a;"/>

                <Run Text="• Фильтрация отчётов по контроллеру и сотруднику.&#x0a;"/>

                <Run Text="• Расчёт первого прихода, последнего ухода и рабочего времени.&#x0a;"/>

                <Run Text="• Экспорт отчёта посещаемости в Excel.&#x0a;"/>

                <Run Text="• Экспорт отчёта посещаемости в PDF.&#x0a;"/>

                <Run Text="• Формирование табеля учёта рабочего времени.&#x0a;"/>

                <Run Text="• Выбор сотрудников, включаемых в табель.&#x0a;"/>

                <Run Text="• Предпросмотр табеля перед сохранением.&#x0a;"/>

                <Run Text="• Сохранение табеля в Excel после предпросмотра.&#x0a;"/>

                <Run Text="• Автоматическое создание отдельных листов Excel при периоде, включающем несколько месяцев.&#x0a;&#x0a;"/>


                <Run Text="Графики работы&#x0a;&#x0a;"/>

                <Run Text="• Создание произвольного количества графиков работы.&#x0a;"/>

                <Run Text="• Настройка времени начала и окончания смены.&#x0a;"/>

                <Run Text="• Настройка индивидуальной нормы часов для каждого графика.&#x0a;"/>

                <Run Text="• Поддержка графиков с нормой 8, 6 и любым другим количеством часов.&#x0a;"/>

                <Run Text="• Назначение графиков отдельным сотрудникам.&#x0a;"/>

                <Run Text="• Массовое назначение одного графика нескольким сотрудникам с помощью галочек.&#x0a;"/>

                <Run Text="• История изменения графиков сотрудников по датам.&#x0a;"/>

                <Run Text="• Удаление ошибочно назначенного графика сотруднику.&#x0a;"/>

                <Run Text="• При формировании табеля норма рабочего времени автоматически определяется по графику сотрудника на конкретную дату.&#x0a;"/>

                <Run Text="• Если сотруднику график не назначен, используется норма 8 часов по умолчанию.&#x0a;&#x0a;"/>


                <Run Text="Резервное копирование&#x0a;&#x0a;"/>

                <Run Text="• Настройки резервного копирования непосредственно из программы.&#x0a;"/>

                <Run Text="• Ручное создание резервной копии всех локальных баз.&#x0a;"/>

                <Run Text="• Прямое архивирование папки с базами через 7-Zip.&#x0a;"/>

                <Run Text="• Возможность выбора папки для хранения резервных копий.&#x0a;"/>

                <Run Text="• Защита архивов паролем.&#x0a;"/>

                <Run Text="• Шифрование имён файлов внутри архива.&#x0a;"/>

                <Run Text="• Архивирование используемых программой баз с параметром 7-Zip -ssw.&#x0a;"/>

                <Run Text="• Автоматический резервный бэкап по расписанию.&#x0a;"/>

                <Run Text="• Автоматическое создание и обновление задания в Планировщике заданий Windows.&#x0a;"/>

                <Run Text="• Автоматическое удаление резервных копий старше заданного количества дней.&#x0a;&#x0a;"/>


                <Run Text="Хранение данных&#x0a;&#x0a;"/>

                <Run Text="Каждый объект может использовать отдельную SQLite-базу данных.&#x0a;&#x0a;"/>

                <Run Text="В базе объекта могут храниться:&#x0a;"/>

                <Run Text="• контроллеры объекта;&#x0a;"/>

                <Run Text="• события посещаемости;&#x0a;"/>

                <Run Text="• графики работы;&#x0a;"/>

                <Run Text="• назначения графиков сотрудникам.&#x0a;&#x0a;"/>

                <Run Text="Такая структура позволяет централизованно работать с несколькими объектами и в дальнейшем использовать базы, расположенные в общем или удалённом хранилище.&#x0a;&#x0a;"/>


                <Run Text="Используемые технологии&#x0a;&#x0a;"/>

                <Run Text="Для обмена данными с контроллерами используются стандартные сетевые интерфейсы Dahua:&#x0a;&#x0a;"/>

                <Run Text="• HTTP Digest Authentication&#x0a;"/>

                <Run Text="• CGI API&#x0a;"/>

                <Run Text="• RPC2 API&#x0a;&#x0a;"/>

                <Run Text="Для хранения локальных данных используется SQLite.&#x0a;"/>

                <Run Text="Для экспорта отчётов и табелей используется формат Microsoft Excel.&#x0a;"/>

                <Run Text="Для формирования PDF-отчётов используется QuestPDF.&#x0a;"/>

                <Run Text="Для резервного копирования используется 7-Zip и Планировщик заданий Windows.&#x0a;&#x0a;"/>

                <Run Text="Программа работает без использования Dahua SDK.&#x0a;&#x0a;"/>


                <Run Text="Совместимость&#x0a;&#x0a;"/>

                <Run Text="Программа протестирована на контроллерах серии DHI-ASI6213S-PW.&#x0a;&#x0a;"/>

                <Run Text="Совместима с современными прошивками Dahua, поддерживающими используемые CGI и RPC2 API.&#x0a;&#x0a;"/>


                <Run Text="Особенности&#x0a;&#x0a;"/>

                <Run Text="Операции создания, изменения, удаления пользователей и работы с фотографиями выполняются непосредственно на контроллерах.&#x0a;&#x0a;"/>

                <Run Text="Локальная база используется для хранения рабочих данных программы, истории посещаемости, графиков и настроек объекта.&#x0a;&#x0a;"/>

                <Run Text="Для основной работы программа не требует облачных сервисов или промежуточного сервера.&#x0a;&#x0a;"/>


                <Run Text="Разработчик&#x0a;&#x0a;"/>

                <Run Text="Из прекрасного города Караганда — Kill_l&#x0a;"/>

                <Run Text="E-mail: Predator_l@mail.ru&#x0a;&#x0a;"/>

                <Run Text="Разработано для себя — и поделюсь.&#x0a;&#x0a;"/>

                <Run Text="Все права защищены.&#x0a;"/>

                <Run Text="© 2026"/>

            </TextBlock>

        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="110"
                Height="34"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Click="Close_Click"/>

    </Grid>
</Window>