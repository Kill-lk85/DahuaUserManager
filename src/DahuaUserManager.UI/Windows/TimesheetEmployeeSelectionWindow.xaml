<Window x:Class="DahuaUserManager.UI.Windows.TimesheetEmployeeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники для табеля"
        Height="620"
        Width="520"
        MinHeight="450"
        MinWidth="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top"
                    Margin="0,0,0,10">

            <TextBlock Text="Выберите сотрудников, которые должны попасть в табель:"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Height="30"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>

                <Button Grid.Column="1"
                        Content="Выбрать всех"
                        Width="110"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="SelectAll_Click"/>

                <Button Grid.Column="2"
                        Content="Снять всех"
                        Width="100"
                        Height="30"
                        Click="ClearAll_Click"/>
            </Grid>

        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <TextBlock x:Name="SelectedCountText"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"
                       FontWeight="Bold"/>

            <Button Content="ОК"
                    Width="100"
                    Height="34"
                    Margin="4"
                    IsDefault="True"
                    Click="Ok_Click"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="34"
                    Margin="4"
                    IsCancel="True"/>
        </StackPanel>

        <Border BorderBrush="#D0D0D0"
                BorderThickness="1">

            <ListBox x:Name="EmployeesList"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="EmployeeCheck_Changed"
                                  Unchecked="EmployeeCheck_Changed"
                                  Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserName}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="  (UserID: "
                                           Foreground="Gray"/>
                                <TextBlock Text="{Binding UserId}"
                                           Foreground="Gray"/>
                                <TextBlock Text=")"
                                           Foreground="Gray"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

    </DockPanel>
</Window>
