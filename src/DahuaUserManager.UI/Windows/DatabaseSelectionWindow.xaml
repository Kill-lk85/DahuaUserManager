<Window x:Class="DahuaUserManager.UI.Windows.DatabaseSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор базы данных"
        Width="560"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Выбор базы данных"
                   FontSize="22"
                   FontWeight="Bold"/>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="База / объект:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="DatabaseComboBox"
                      Grid.Column="1"
                      Height="34"
                      DisplayMemberPath="Name"
                      SelectionChanged="DatabaseComboBox_SelectionChanged"/>

        </Grid>

        <Grid Grid.Row="3"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Файл:"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="DatabaseFileText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

        </Grid>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Создать новую базу"
                    Width="160"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="CreateDatabase_Click"/>

            <Button Content="Открыть"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="OpenDatabase_Click"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="36"
                    IsCancel="True"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>
</Window>