<Window x:Class="DahuaUserManager.UI.Windows.AttendanceReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт о посещаемости"
        Height="760"
        Width="1400"
        MinHeight="600"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Сформировать"
                    Width="130"
                    Height="34"
                    Margin="4"
                    Click="LoadReport_Click"/>

            <Button Content="Экспорт Excel"
                    Width="130"
                    Height="34"
                    Margin="4"
                    Click="ExportExcel_Click"/>

            <Button x:Name="TimesheetEmployeesButton"
                    Content="Сотрудники табеля"
                    Width="155"
                    Height="34"
                    Margin="4"
                    Click="SelectTimesheetEmployees_Click"/>

            <Button Content="Табель Excel"
                    Width="130"
                    Height="34"
                    Margin="4"
                    Click="ExportTimesheetExcel_Click"/>

            <Button Content="Экспорт PDF"
                    Width="120"
                    Height="34"
                    Margin="4"
                    Click="ExportPdf_Click"/>

            <Button Content="Закрыть"
                    Width="110"
                    Height="34"
                    Margin="4"
                    Click="Close_Click"/>
        </StackPanel>

        <Border DockPanel.Dock="Top"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Контроллер:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox x:Name="ControllerComboBox"
                          Grid.Column="1"
                          Height="30"
                          DisplayMemberPath="Name"
                          SelectionChanged="ControllerFilter_SelectionChanged"/>

                <TextBlock Text="Сотрудник:"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <ComboBox x:Name="EmployeeComboBox"
                          Grid.Column="3"
                          Height="30"
                          IsEditable="False"
                          IsTextSearchEnabled="True"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="EmployeeFilter_SelectionChanged"/>

                <TextBlock Text="С:"
                           Grid.Column="4"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <DatePicker x:Name="DateFromPicker"
                            Grid.Column="5"
                            Height="30"/>

                <TextBlock Text="По:"
                           Grid.Column="6"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <DatePicker x:Name="DateToPicker"
                            Grid.Column="7"
                            Height="30"/>

                <TextBlock x:Name="CountText"
                           Grid.Column="8"
                           Text="Записей: 0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="15,0,0,0"/>
            </Grid>
        </Border>

        <TabControl>

            <TabItem Header="Итоги">
                <DataGrid x:Name="SummaryGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          Margin="0,5">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date}"
                                            Width="100"/>

                        <DataGridTextColumn Header="UserID"
                                            Binding="{Binding UserId}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Сотрудник"
                                            Binding="{Binding UserName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Пришёл"
                                            Binding="{Binding FirstEntry}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Ушёл"
                                            Binding="{Binding LastExit}"
                                            Width="95"/>

                        <DataGridTextColumn Header="Рабочее время"
                                            Binding="{Binding WorkTime}"
                                            Width="125"/>

                        <DataGridTextColumn Header="Отсутствовал"
                                            Binding="{Binding AbsenceTime}"
                                            Width="125"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Result}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Журнал событий">
                <DataGrid x:Name="AttendanceGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          Margin="0,5">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Время"
                                            Binding="{Binding Time}"
                                            Width="90"/>

                        <DataGridTextColumn Header="UserID"
                                            Binding="{Binding UserId}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Сотрудник"
                                            Binding="{Binding UserName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Контроллер"
                                            Binding="{Binding ControllerName}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Событие"
                                            Binding="{Binding Event}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding AttendanceResult}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
